# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Repository tooling, not part of the chart
node_modules/
package.json
package-lock.json
sync-versions.js
lint-staged.config.js
.changeset/
.github/
.husky/
.nvmrc
.prettierrc
.prettierignore
